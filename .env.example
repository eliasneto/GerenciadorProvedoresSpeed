# --- DJANGO ---
SECRET_KEY=

# --- BANCO DE DADOS / DOCKER ---
MYSQL_DATABASE=speed_prod
MYSQL_USER=speed_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

DB_NAME=speed_prod
DB_USER=speed_app
DB_PASSWORD=
DB_HOST=speed_db
DB_PORT=3306

# --- AUTENTICACAO AD / LDAP ---
USE_AD_AUTH=false
AD_SERVER_URI=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_USER_SEARCH_BASE=
AD_GROUP_SEARCH_BASE=
AD_GROUP_SGP_ACCESS=
AD_DEFAULT_DOMAIN=

# --- ADMIN LOCAL ---
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- EMAIL / SMTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# --- MICROSOFT GRAPH / RESPOSTAS DE E-MAIL DAS COTACOES ---
GRAPH_EMAIL_REPLIES_ENABLED=false
GRAPH_EMAIL_REPLIES_CLIENT_ID=
GRAPH_EMAIL_REPLIES_CLIENT_SECRET=
GRAPH_EMAIL_REPLIES_TENANT_ID=
GRAPH_EMAIL_REPLIES_MAILBOX=
GRAPH_EMAIL_REPLIES_INITIAL_LOOKBACK_DAYS=15
GRAPH_EMAIL_REPLIES_TIMEOUT=30
GRAPH_EMAIL_REPLIES_MAX_PAGES_PER_RUN=20

# --- IXC / API ---
IXC_URL=https://ixc.megainfraestrutura.com.br/webservice/v1
IXC_TOKEN=

# --- IXC / PAINEL WEB ---
IXC_PANEL_EMAIL=
IXC_PANEL_PASSWORD=

# --- DASHBOARD EACE (ADR-009) ---
# Substitui a sincronizacao de Cliente/Endereco do IXC (desativada pela
# ADR-008). Contrato confirmado em API_EXTERNA.md: DASHBOARD_EACE_URL deve
# incluir o prefixo /api/v1 (ex.: http://<host>/api/v1); DASHBOARD_EACE_TOKEN
# vai no header X-API-Key. Mapeamento de campos para Cliente/Endereco ainda
# nao implementado - falta o schema completo de EscolaOut (ver /docs no
# DashboardEACE, ainda nao disponivel neste repositorio).
DASHBOARD_EACE_URL=
DASHBOARD_EACE_TOKEN=

# --- BACKUP / CIFS ---
# Dias de retencao do backup ZIP (banco + media), tanto na copia local em
# media/backups/ quanto na copia no compartilhamento Windows. Sem limpeza
# local, o backup diario enche o disco do servidor (docs/devops/TROUBLESHOOTING.md).
#BACKUP_RETENTION_DAYS=10
#BACKUP_WINDOWS_USER=
#BACKUP_WINDOWS_PASSWORD=
#BACKUP_WINDOWS_DOMAIN=
#BACKUP_WINDOWS_HOST=
#BACKUP_WINDOWS_SHARE=
#BACKUP_WINDOWS_SUBDIR=

# --- GOOGLE / SERPER ---
SERPER_API_KEY=

# --- HUB DO DESENVOLVEDOR / BUSCA DE CEP ---
HUB_DO_DEV_TOKEN=
